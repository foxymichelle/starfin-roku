import "pkg:/source/String.bs"
import "pkg:/source/Remote.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Theme.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/MaskAssets.bs"
import "pkg:/source/ResolutionProfile.bs"
import "pkg:/source/ResolutionAssets.bs"
import "pkg:/source/AccountImage.bs"
import "pkg:/source/PlaybackMode.bs"
import "pkg:/source/store/RegistryStore.bs"
import "pkg:/source/store/SettingsStore.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("Header", m.global.logService)
    initReferences()
    rebuildFocusableHeaderButtons()
    initHandlers()

    initStyle()
    updateUserMenuButton()
    closeSystemMenu()
    closeAccountMenu()
    syncMenuOpen()
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.navGroup = m.top.findNode("navGroup")
    m.navGlassBackground = m.top.findNode("navGlassBackground")
    m.homeButton = m.top.findNode("homeButton")
    m.searchButton = m.top.findNode("searchButton")
    m.systemButton = m.top.findNode("systemButton")
    m.userMenuButton = m.top.findNode("userMenuButton")
    m.accountBadge = m.top.findNode("accountBadge")
    m.topHomeGroup = m.top.findNode("topHomeGroup")
    m.topHomeIcon = m.top.findNode("topHomeIcon")
    m.topSearchGroup = m.top.findNode("topSearchGroup")
    m.topSearchIcon = m.top.findNode("topSearchIcon")
    m.clock = m.top.findNode("clock")
    m.systemDropdownMenu = m.top.findNode("systemDropdownMenu")
    m.accountDropdownMenu = m.top.findNode("accountDropdownMenu")
    m.focusableHeaderButtons = []
end sub

'-------------------------------------------------------------------------------
' onThumbnailLibraryLayoutChanged
'-------------------------------------------------------------------------------
sub onThumbnailLibraryLayoutChanged()
    if m.top.thumbnailLibraryLayout = true then
        m.clock.translation = [1704, 32]
    else
        m.clock.translation = [1680, 32]
    end if
    layoutTopLeftIcons()
end sub

'-------------------------------------------------------------------------------
' layoutTopLeftIcons
'-------------------------------------------------------------------------------
sub layoutTopLeftIcons()
    iconGap = 52
    iconSize = 40
    cursorX = 48

    if m.accountBadge <> invalid and m.accountBadge.visible = true then
        badgeW = m.accountBadge.callFunc("getContentWidth")
        if badgeW = invalid or badgeW < 96 then badgeW = 96
        cursorX = 48 + badgeW + iconGap
    end if

    if m.topHomeGroup <> invalid and m.topHomeGroup.visible = true then
        m.topHomeGroup.translation = [cursorX, 44]
        cursorX = cursorX + iconSize + iconGap
    end if

    if m.topSearchGroup <> invalid and m.topSearchGroup.visible = true then
        m.topSearchGroup.translation = [cursorX, 44]
    end if
end sub

'-------------------------------------------------------------------------------
' onActivePageChanged
'-------------------------------------------------------------------------------
sub onActivePageChanged()
    page = LCase(Strings.ToString(m.top.activePage, "home"))
    if m.topHomeGroup <> invalid then
        m.topHomeGroup.visible = (page <> "home")
    end if
    if m.topSearchGroup <> invalid then
        m.topSearchGroup.visible = (page <> "search")
    end if
    layoutTopLeftIcons()
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.global.observeField("theme", "updateAccountBadgeTheme")
    m.homeButton.observeField("buttonSelected", "onHomePressed")
    m.searchButton.observeField("buttonSelected", "onSearchPressed")
    m.systemButton.observeField("buttonSelected", "onSystemPressed")
    m.userMenuButton.observeField("buttonSelected", "onUserMenuPressed")
    m.accountBadge.observeField("buttonSelected", "onUserMenuPressed")
    m.accountBadge.observeField("focusedChild", "onAccountBadgeFocusChanged")
    m.topHomeGroup.observeField("focusedChild", "syncTopBarFocusVisuals")
    m.topSearchGroup.observeField("focusedChild", "syncTopBarFocusVisuals")
    m.systemDropdownMenu.observeField("selectedItem", "onSystemDropdownItemSelected")
    m.accountDropdownMenu.observeField("selectedItem", "onAccountDropdownItemSelected")
end sub

'-------------------------------------------------------------------------------
' initStyle
'-------------------------------------------------------------------------------
sub initStyle()
    palette = Theme.Get()
    configureAccountBadgePosition()
    m.navGlassBackground.uri = Theme.HeaderMenu(Theme.Mode.Blue).glassUri
    headerBgColor = palette.background.header
    m.homeButton.headerBgColor = headerBgColor
    m.searchButton.headerBgColor = headerBgColor
    m.systemButton.headerBgColor = headerBgColor
    m.userMenuButton.headerBgColor = headerBgColor
    updateAccountBadgeTheme()
    m.systemDropdownMenu.items = getSystemDropdownItems()
    m.accountDropdownMenu.items = getAccountDropdownItems()
end sub

'-------------------------------------------------------------------------------
' focusHeader
'-------------------------------------------------------------------------------
function focusHeader() as boolean
    closeMenu()
    page = LCase(Strings.ToString(m.top.activePage, "home"))

    if page <> "home" and m.topHomeGroup <> invalid and m.topHomeGroup.visible = true then
        m.topHomeGroup.setFocus(true)
        syncTopBarFocusVisuals()
        return true
    end if

    if m.accountBadge <> invalid and m.accountBadge.visible = true then
        m.accountBadge.setFocus(true)
        syncTopBarFocusVisuals()
        return true
    end if

    topBarNodes = getTopBarFocusableNodes()
    if topBarNodes.Count() > 0 then
        topBarNodes[0].setFocus(true)
        syncTopBarFocusVisuals()
        return true
    end if

    return false
end function

'-------------------------------------------------------------------------------
' focusSystemMenuButton
'-------------------------------------------------------------------------------
function focusSystemMenuButton() as boolean
    closeMenu()
    m.systemButton.setFocus(true)
    return true
end function

'-------------------------------------------------------------------------------
' focusUserMenuButton
'-------------------------------------------------------------------------------
function focusUserMenuButton() as boolean
    closeMenu()
    if m.userMenuButton = invalid then return false

    m.userMenuButton.setFocus(true)
    return true
end function

'-------------------------------------------------------------------------------
' isHomeButtonFocused
'-------------------------------------------------------------------------------
function isHomeButtonFocused() as boolean
    return m.homeButton <> invalid and m.homeButton.isInFocusChain()
end function

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false

    if m.top.menuOpen = true then
        openMenu = getOpenDropdownMenu()
        if openMenu <> invalid then
            if key = Remote.Key.Up then return openMenu.callFunc("focusByOffset", -1)
            if key = Remote.Key.Down then return openMenu.callFunc("focusByOffset", 1)
        end if
    end if

    topBarNodes = getTopBarFocusableNodes()
    topIdx = getFocusedTopBarIndex(topBarNodes)

    if topIdx >= 0 then
        if key = Remote.Key.Left then
            nextIdx = topIdx - 1
            if nextIdx < 0 then nextIdx = topBarNodes.Count() - 1
            topBarNodes[nextIdx].setFocus(true)
            syncTopBarFocusVisuals()
            return true
        else if key = Remote.Key.Right then
            nextIdx = topIdx + 1
            if nextIdx >= topBarNodes.Count() then
                if m.top.hasLibrarySortControls = true then
                    clearTopBarFocusVisuals()
                    m.top.exitRightSelected = true
                    return true
                end if
                nextIdx = 0
            end if
            topBarNodes[nextIdx].setFocus(true)
            syncTopBarFocusVisuals()
            return true
        else if key = Remote.Key.OK then
            if topBarNodes[topIdx].isSameNode(m.topHomeGroup) then
                clearTopBarFocusVisuals()
                m.top.homeSelected = true
                return true
            else if topBarNodes[topIdx].isSameNode(m.topSearchGroup) then
                clearTopBarFocusVisuals()
                m.top.searchSelected = true
                return true
            end if
        else if key = Remote.Key.Down or key = Remote.Key.Back then
            clearTopBarFocusVisuals()
            closeMenu()
            m.top.downSelected = true
            return true
        end if
    end if

    return false
end function

'-------------------------------------------------------------------------------
' focusHeaderButtonByOffset
'-------------------------------------------------------------------------------
function focusHeaderButtonByOffset(offset as integer) as boolean
    headerButtons = m.focusableHeaderButtons
    if headerButtons = invalid or headerButtons.Count() = 0 then return false

    currentIndex = getFocusedHeaderButtonIndex()
    if currentIndex < 0 then
        return focusHeader()
    end if

    nextIndex = currentIndex + offset
    lastIndex = headerButtons.Count() - 1

    if nextIndex < 0 then
        nextIndex = lastIndex
    else if nextIndex > lastIndex then
        nextIndex = 0
    end if

    closeMenu()

    nextButton = headerButtons[nextIndex]
    if nextButton = invalid then return false

    nextButton.setFocus(true)
    return true
end function

'-------------------------------------------------------------------------------
' rebuildFocusableHeaderButtons
'-------------------------------------------------------------------------------
sub rebuildFocusableHeaderButtons()
    m.focusableHeaderButtons = []

    m.focusableHeaderButtons.Push(m.homeButton)
    m.focusableHeaderButtons.Push(m.searchButton)
    m.focusableHeaderButtons.Push(m.systemButton)
    m.focusableHeaderButtons.Push(m.userMenuButton)
end sub

'-------------------------------------------------------------------------------
' getFocusedHeaderButtonIndex
'-------------------------------------------------------------------------------
function getFocusedHeaderButtonIndex() as integer
    headerButtons = m.focusableHeaderButtons
    if headerButtons = invalid then return -1

    for i = 0 to headerButtons.Count() - 1
        button = headerButtons[i]
        if button <> invalid and button.isInFocusChain() then return i
    end for

    if isSystemMenuInFocusChain() then return 2
    if isUserMenuInFocusChain() then return 3

    return -1
end function

'-------------------------------------------------------------------------------
' onCloseMenuRequested
'-------------------------------------------------------------------------------
sub onCloseMenuRequested()
    closeMenu()
end sub

'-------------------------------------------------------------------------------
' onUsernameChanged
'-------------------------------------------------------------------------------
sub onUsernameChanged()
    updateUserMenuButton()
end sub

'-------------------------------------------------------------------------------
' onUserIdentityRequestChanged
'-------------------------------------------------------------------------------
sub onUserIdentityRequestChanged()
    updateUserMenuButton()
end sub

'-------------------------------------------------------------------------------
' onSettingsChanged
'-------------------------------------------------------------------------------
sub onSettingsChanged()
    updateAccountBadge()
end sub

'-------------------------------------------------------------------------------
' configureAccountDropdownIdentity
'-------------------------------------------------------------------------------
sub configureAccountDropdownIdentity()
    request = m.top.userIdentityRequest
    if request = invalid then return

    imageUri = "pkg:/images/cast/cast-placeholder-195x195.png"
    imageSource = "placeholder"
    if Strings.ToString(request.primaryImageTag) <> "" then
        imageUri = AccountImage.GetUri(request, 144, 144)
        imageSource = "profile"
    end if
    m.log.write("User identity image selected source=" + imageSource + " uri=" + imageUri)
    menuMaskProfile = MaskAssets.GetProfile("account-menu-user-mask.png", [144, 144], [96, 96])
    m.accountDropdownMenu.identity = {
        name: m.top.username
        imageUri: imageUri
        maskUri: menuMaskProfile.uri
        maskSize: menuMaskProfile.size
        imageSize: 144
    }
end sub

'-------------------------------------------------------------------------------
' onHomePressed
'-------------------------------------------------------------------------------
sub onHomePressed()
    closeMenu()
    m.top.homeSelected = true
end sub

'-------------------------------------------------------------------------------
' onSearchPressed
'-------------------------------------------------------------------------------
sub onSearchPressed()
    closeMenu()
    m.top.searchSelected = true
end sub

'-------------------------------------------------------------------------------
' onSystemPressed
'-------------------------------------------------------------------------------
sub onSystemPressed()
    closeAccountMenu()
    m.systemDropdownMenu.callFunc("toggleMenu")
    syncMenuOpen()
end sub

'-------------------------------------------------------------------------------
' configureAccountBadgePosition
'-------------------------------------------------------------------------------
sub configureAccountBadgePosition()
    verticalPosition = 16
    if ResolutionProfile.IsHd() then verticalPosition = 25

    m.accountBadge.translation = [48, verticalPosition]
end sub

'-------------------------------------------------------------------------------
' onUserMenuPressed
'-------------------------------------------------------------------------------
sub onUserMenuPressed()
    closeMenu()
    m.top.switchAccountSelected = true
end sub

'-------------------------------------------------------------------------------
' onSystemDropdownItemSelected
'-------------------------------------------------------------------------------
sub onSystemDropdownItemSelected()
    selectedItem = m.systemDropdownMenu.selectedItem
    if selectedItem = invalid then return

    closeMenu()
    if selectedItem.id = "settings" then
        requestSettingsOverlay()
    else if selectedItem.id = "systemInformation" then
        requestSystemInformationOverlay()
    else if selectedItem.id = "logs" then
        requestLogsOverlay()
    end if
end sub

'-------------------------------------------------------------------------------
' onAccountDropdownItemSelected
'-------------------------------------------------------------------------------
sub onAccountDropdownItemSelected()
    selectedItem = m.accountDropdownMenu.selectedItem
    if selectedItem = invalid then return

    closeMenu()
    if selectedItem.id = "switchAccount" then
        m.top.switchAccountSelected = true
    else if selectedItem.id = "logout" then
        m.top.logoutSelected = true
    end if
end sub

'-------------------------------------------------------------------------------
' requestSystemInformationOverlay
'-------------------------------------------------------------------------------
sub requestSystemInformationOverlay()
    m.top.overlayRequested = {
        id: "systemInformation"
        componentName: "SystemInformationDialog"
        closeField: "closeRequested"
        openFunction: "openSystemInformation"
    }
end sub

'-------------------------------------------------------------------------------
' requestLogsOverlay
'-------------------------------------------------------------------------------
sub requestLogsOverlay()
    m.top.overlayRequested = {
        id: "logs"
        componentName: "LogDialog"
        closeField: "closeRequested"
        openFunction: "openLogs"
    }
end sub

'-------------------------------------------------------------------------------
' requestSettingsOverlay
'-------------------------------------------------------------------------------
sub requestSettingsOverlay()
    m.top.overlayRequested = {
        id: "settings"
        componentName: "SettingsDialog"
        closeField: "closeRequested"
        openFunction: "openSettings"
    }
end sub

'-------------------------------------------------------------------------------
' closeMenu
'-------------------------------------------------------------------------------
sub closeMenu()
    wasSystemMenuOpen = isSystemMenuOpen()
    wasUserMenuOpen = isAccountMenuOpen()

    closeSystemMenu()
    closeAccountMenu()
    syncMenuOpen()

    if wasSystemMenuOpen then
        m.systemButton.setFocus(true)
    else if wasUserMenuOpen then
        m.userMenuButton.setFocus(true)
    end if
end sub

'-------------------------------------------------------------------------------
' closeSystemMenu
'-------------------------------------------------------------------------------
sub closeSystemMenu()
    m.systemDropdownMenu.callFunc("closeMenu")
end sub

'-------------------------------------------------------------------------------
' closeAccountMenu
'-------------------------------------------------------------------------------
sub closeAccountMenu()
    m.accountDropdownMenu.callFunc("closeMenu")
end sub

'-------------------------------------------------------------------------------
' syncMenuOpen
'-------------------------------------------------------------------------------
sub syncMenuOpen()
    m.top.menuOpen = isSystemMenuOpen() or isAccountMenuOpen()
end sub

'-------------------------------------------------------------------------------
' getOpenDropdownMenu
'-------------------------------------------------------------------------------
function getOpenDropdownMenu() as dynamic
    if isSystemMenuOpen() then return m.systemDropdownMenu
    if isAccountMenuOpen() then return m.accountDropdownMenu
    return invalid
end function

'-------------------------------------------------------------------------------
' isSystemMenuOpen
'-------------------------------------------------------------------------------
function isSystemMenuOpen() as boolean
    return m.systemDropdownMenu.isOpen = true
end function

'-------------------------------------------------------------------------------
' isAccountMenuOpen
'-------------------------------------------------------------------------------
function isAccountMenuOpen() as boolean
    return m.accountDropdownMenu.isOpen = true
end function

'-------------------------------------------------------------------------------
' updateUserMenuButton
'-------------------------------------------------------------------------------
sub updateUserMenuButton()
    if m.userMenuButton = invalid then return
    if m.top.userIdentityRequest <> invalid then
        configureAccountDropdownIdentity()
        updateAccountBadge()
        return
    end if

    m.accountDropdownMenu.identity = invalid
    updateAccountBadge()
end sub

'-------------------------------------------------------------------------------
' updateAccountBadge
'-------------------------------------------------------------------------------
sub updateAccountBadge()
    showBadge = SettingsStore.GetSettingValue(m.top.settings, SettingsStore.Key.DisplayAccountBadge) = "on"
    request = m.top.userIdentityRequest
    m.accountBadge.visible = showBadge and request <> invalid
    if m.accountBadge.visible <> true then return

    imageUri = "pkg:/images/cast/cast-placeholder-195x195.png"
    if Strings.ToString(request.primaryImageTag) <> "" then imageUri = AccountImage.GetUri(request, 192, 192)
    m.accountBadge.imageUri = imageUri
    m.accountBadge.username = m.top.username
    layoutTopLeftIcons()
end sub

'-------------------------------------------------------------------------------
' getSystemDropdownItems
'-------------------------------------------------------------------------------
function getSystemDropdownItems() as object
    return [
        { id: "settings", text: "Settings", iconUri: "pkg:/images/icons/header/settings.png", iconWidth: 25 }
        { id: "systemInformation", text: "System Info", iconUri: "pkg:/images/icons/header/system-info.png", iconWidth: 22 }
        { id: "logs", text: "App Log", iconUri: "pkg:/images/icons/header/app-log.png", iconWidth: 15 }
    ]
end function

'-------------------------------------------------------------------------------
' getAccountDropdownItems
'-------------------------------------------------------------------------------
function getAccountDropdownItems() as object
    return [
        { id: "switchAccount", text: "Switch", iconUri: "pkg:/images/icons/header/switch-account.png", iconWidth: 25 }
        { id: "logout", text: "Logout", iconUri: "pkg:/images/icons/header/logout.png", iconWidth: 21 }
    ]
end function

'-------------------------------------------------------------------------------
' isSystemMenuInFocusChain
'-------------------------------------------------------------------------------
function isSystemMenuInFocusChain() as boolean
    return m.systemDropdownMenu.callFunc("isMenuFocused")
end function

'-------------------------------------------------------------------------------
' isUserMenuInFocusChain
'-------------------------------------------------------------------------------
function isUserMenuInFocusChain() as boolean
    return m.accountDropdownMenu.callFunc("isMenuFocused")
end function

'-------------------------------------------------------------------------------
' updateAccountBadgeTheme
'-------------------------------------------------------------------------------
sub updateAccountBadgeTheme()
    palette = Theme.AccountBadge(m.global.theme)
    m.accountBadge.backgroundColor = palette.background
    m.accountBadge.ringColor = palette.ring
    m.accountBadge.glassColor = palette.glass
end sub

'-------------------------------------------------------------------------------
' getTopBarFocusableNodes
'-------------------------------------------------------------------------------
function getTopBarFocusableNodes() as object
    nodes = []
    if m.accountBadge <> invalid and m.accountBadge.visible = true then nodes.Push(m.accountBadge)
    if m.topHomeGroup <> invalid and m.topHomeGroup.visible = true then nodes.Push(m.topHomeGroup)
    if m.topSearchGroup <> invalid and m.topSearchGroup.visible = true then nodes.Push(m.topSearchGroup)
    return nodes
end function

'-------------------------------------------------------------------------------
' getFocusedTopBarIndex
'-------------------------------------------------------------------------------
function getFocusedTopBarIndex(nodes as object) as integer
    for i = 0 to nodes.Count() - 1
        if nodes[i] <> invalid and nodes[i].isInFocusChain() then return i
    end for
    return -1
end function

'-------------------------------------------------------------------------------
' syncTopBarFocusVisuals
'-------------------------------------------------------------------------------
sub syncTopBarFocusVisuals()
    if m.accountBadge <> invalid then
        m.accountBadge.focused = m.accountBadge.isInFocusChain()
    end if
    if m.topHomeGroup <> invalid then
        if m.topHomeGroup.isInFocusChain() then
            m.topHomeGroup.scale = [1.26, 1.26]
            if m.topHomeIcon <> invalid then m.topHomeIcon.blendColor = "0xFFFFFFFF"
        else
            m.topHomeGroup.scale = [1.0, 1.0]
            if m.topHomeIcon <> invalid then m.topHomeIcon.blendColor = "0xD0D7E2FF"
        end if
    end if
    if m.topSearchGroup <> invalid then
        if m.topSearchGroup.isInFocusChain() then
            m.topSearchGroup.scale = [1.26, 1.26]
            if m.topSearchIcon <> invalid then m.topSearchIcon.blendColor = "0xFFFFFFFF"
        else
            m.topSearchGroup.scale = [1.0, 1.0]
            if m.topSearchIcon <> invalid then m.topSearchIcon.blendColor = "0xD0D7E2FF"
        end if
    end if
end sub

'-------------------------------------------------------------------------------
' clearTopBarFocusVisuals
'-------------------------------------------------------------------------------
sub clearTopBarFocusVisuals()
    if m.accountBadge <> invalid then m.accountBadge.focused = false
    if m.topHomeGroup <> invalid then
        m.topHomeGroup.scale = [1.0, 1.0]
        if m.topHomeIcon <> invalid then m.topHomeIcon.blendColor = "0xD0D7E2FF"
    end if
    if m.topSearchGroup <> invalid then
        m.topSearchGroup.scale = [1.0, 1.0]
        if m.topSearchIcon <> invalid then m.topSearchIcon.blendColor = "0xD0D7E2FF"
    end if
end sub

'-------------------------------------------------------------------------------
' onAccountBadgeFocusChanged
'-------------------------------------------------------------------------------
sub onAccountBadgeFocusChanged()
    syncTopBarFocusVisuals()
end sub

'-------------------------------------------------------------------------------
' focusRightmostHeaderControl
'-------------------------------------------------------------------------------
function focusRightmostHeaderControl() as boolean
    closeMenu()
    topBarNodes = getTopBarFocusableNodes()
    if topBarNodes.Count() = 0 then return false
    lastNode = topBarNodes[topBarNodes.Count() - 1]
    lastNode.setFocus(true)
    syncTopBarFocusVisuals()
    return true
end function