    </Group>

    <Group id="cfSliderGroup" visible="false">
      <Rectangle id="cfSliderFocusBorder" color="0xFFFFFFFF" width="1760" height="540" visible="false" />
      <Poster id="cfSliderPoster" width="1752" height="532" loadDisplayMode="scaleToZoom" />
      <Rectangle id="cfSliderScrim" color="0x00000099" width="1752" height="130" />
      <Label id="cfSliderTitle" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" width="1672" height="44" />
      <Label id="cfSliderOverview" color="0xDDDDDDFF" font="font:SmallSystemFont" width="1672" height="56" wrap="true" maxLines="2" />
    </Group>
  </children>
</component>
