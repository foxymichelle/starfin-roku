import "pkg:/source/RequestFailure.bs"
import "pkg:/source/JellyfinImage.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"
import "pkg:/source/TaskResponse.bs"
import "pkg:/source/ApiPayload.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("CustomHomeRowsTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    try
        request = m.top.request
        validationError = TaskRequest.ValidateRequest(request, "customHomeRows")
        if validationError <> invalid then
            m.top.response = validationError
            return
        end if

        userId = TaskRequest.GetUserId(request)
        headers = JellyfinAuth.BuildTokenHeaders(request.token)

        apiUrl = request.server + "/CopperFoxHome/Rows?userId=" + userId + "&t=" + CreateObject("roDateTime").AsSeconds().ToStr()
        if request.rowIndex <> invalid then
            apiUrl = apiUrl + "&rowIndex=" + Strings.ToString(request.rowIndex) + "&skip=" + Strings.ToString(Number.ToInteger(request.skip, 0))
        end if
        apiResponse = HttpClient.Request(apiUrl, "GET", invalid, invalid, headers)

        rowsOutput = []
        if apiResponse.ok = true and apiResponse.data <> invalid and Type(apiResponse.data.rows) = "roArray" then
            for each rowDef in apiResponse.data.rows
                if Type(rowDef) <> "roAssociativeArray" then continue for
                if Strings.ToString(rowDef.rowType) = "StreamingServices" then continue for

                rawItems = rowDef.items
                if Type(rawItems) <> "roArray" or rawItems.Count() = 0 then continue for

                rowTitle = Strings.ToString(rowDef.title)
                if rowTitle = "" then rowTitle = "Row"
                isThumb = (LCase(Strings.ToString(rowDef.imageStyle)) = "thumb")
                isContinue = (Strings.ToString(rowDef.rowType) = "ContinueAndUpNext")

                processedItems = []
                for each item in rawItems
                    if Type(item) <> "roAssociativeArray" then continue for

                    ' Route episodes directly to parent Series on Roku
                    if item.SeriesId <> invalid and Strings.ToString(item.SeriesId) <> "" then
                        item.Id = Strings.ToString(item.SeriesId)
                        item.Type = "Series"
                        if item.SeriesName <> invalid and Strings.ToString(item.SeriesName) <> "" then
                            item.Name = Strings.ToString(item.SeriesName)
                        end if
                    end if

                    ' Build permanent Roku badge text
                    badgeText = ""
                    if isContinue and item.ParentIndexNumber <> invalid and item.IndexNumber <> invalid then
                        badgeText = "S" + Strings.ToString(item.ParentIndexNumber) + ":E" + Strings.ToString(item.IndexNumber)
                    else if (Strings.ToString(item.Type) = "Series" or Strings.ToString(item.Type) = "Episode") and item.IsDiscover <> true and item.ChildCount <> invalid and item.RecursiveItemCount <> invalid then
                        badgeText = Strings.ToString(item.ChildCount) + "S | " + Strings.ToString(item.RecursiveItemCount) + "E"
                    end if

                    item.cfBadgeText = badgeText
                    item.cfIsThumb = isThumb
                    item.cfIsDiscover = (item.IsDiscover = true)
                    item.cfRowType = Strings.ToString(rowDef.rowType)
                    processedItems.Push(item)
                end for

                if rowDef.hasMore = true then
                    processedItems.Push({
                        Id: "CF_LOAD_MORE"
                        Name: "MORE"
                        Type: "CfLoadMore"
                        cfIsLoadMore: true
                        cfRowIndex: rowDef.rowIndex
                        cfRowKey: Strings.ToString(rowDef.key)
                        cfNextSkip: processedItems.Count()
                        cfIsThumb: isThumb
                    })
                end if

                rowsOutput.Push({
                    key: Strings.ToString(rowDef.key)
                    title: rowTitle
                    rowType: Strings.ToString(rowDef.rowType)
                    imageStyle: Strings.ToString(rowDef.imageStyle)
                    hasMore: (rowDef.hasMore = true)
                    rowIndex: rowDef.rowIndex
                    items: processedItems
                })
            end for
        end if

        m.top.response = TaskResponse.Success(request, "customHomeRows", { rows: rowsOutput })
    catch error
        m.log.error("Unable to load custom home rows. Error=" + error.number.ToStr())
        m.top.response = TaskResponse.Success(m.top.request, "customHomeRows", { rows: [] })
    end try
end sub

