import "pkg:/source/JellyfinImage.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"
import "pkg:/source/Array.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = validateRequest(request)
    if validationError <> invalid then
        if request <> invalid then validationError.AddReplace("query", Strings.Trim(request.query))
        m.top.response = validationError
        return
    end if

    moviesAndSeriesResult = searchItems(request, "Movie,Series", "PrimaryImageAspectRatio,Overview,Genres,UserData,Path")
    if moviesAndSeriesResult.ok <> true then
        m.top.response = withAction(moviesAndSeriesResult, request)
        return
    end if

    episodesResult = searchItems(request, "Episode", "PrimaryImageAspectRatio,Overview,SeriesName,ParentIndexNumber,IndexNumber,UserData,Path")
    if episodesResult.ok <> true then
        m.top.response = withAction(episodesResult, request)
        return
    end if

    peopleResult = searchPeople(request)
    if peopleResult.ok <> true then
        m.top.response = withAction(peopleResult, request)
        return
    end if

    movies = []
    shows = []
    discover = []
    for each item in getPayloadItems(moviesAndSeriesResult.data)
        if Arrays.IsAssocArray(item) = false then continue for
        itemPath = LCase(Strings.ToString(item.Path))
        if Instr(1, itemPath, "/discover/") > 0 or Instr(1, itemPath, "\discover\") > 0 then
            discover.Push(item)
        else if LCase(Strings.ToString(item.Type)) = "movie" then
            movies.Push(item)
        else if LCase(Strings.ToString(item.Type)) = "series" then
            shows.Push(item)
        end if
    end for

    ownedEpisodes = []
    for each ep in getPayloadItems(episodesResult.data)
        if Arrays.IsAssocArray(ep) = false then continue for
        epPath = LCase(Strings.ToString(ep.Path))
        if Instr(1, epPath, "/discover/") = 0 and Instr(1, epPath, "\discover\") = 0 then
            ownedEpisodes.Push(ep)
        end if
    end for

    m.top.response = {
        ok: true
        action: "search"
        query: Strings.Trim(request.query)
        payload: {
            movies: movies
            shows: shows
            episodes: ownedEpisodes
            discover: discover
            people: getPayloadItems(peopleResult.data)
        }
    }
end sub

'-------------------------------------------------------------------------------
' searchItems
'-------------------------------------------------------------------------------
function searchItems(request as object, includeItemTypes as string, fields as string) as object
    params = {
        UserId: Strings.ToString(request.userId)
        SearchTerm: Strings.Trim(request.query)
        IncludeItemTypes: includeItemTypes
        Recursive: true
        Limit: 40
        Fields: fields
        EnableImageTypes: Strings.Join([JellyfinImage.Type.Primary, JellyfinImage.Type.Backdrop, JellyfinImage.Type.Thumb])
        ImageTypeLimit: 1
        EnableTotalRecordCount: false
    }

    requestUrl = request.server + "/Users/" + Strings.ToString(request.userId) + "/Items" + Url.BuildQueryString(params)
    return HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
end function

'-------------------------------------------------------------------------------
' searchPeople
'-------------------------------------------------------------------------------
function searchPeople(request as object) as object
    params = {
        UserId: Strings.ToString(request.userId)
        SearchTerm: Strings.Trim(request.query)
        Limit: 40
        ImageTypeLimit: 1
        EnableTotalRecordCount: false
    }

    requestUrl = request.server + "/Persons" + Url.BuildQueryString(params)
    return HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
end function

'-------------------------------------------------------------------------------
' validateRequest
'-------------------------------------------------------------------------------
function validateRequest(request as dynamic) as dynamic
    validationError = TaskRequest.ValidateRequest(request, "search", ["userId"])
    if validationError <> invalid then return validationError

    if Strings.Trim(request.query) = "" then return { ok: false, action: "search", errorMessage: "Enter a search term." }

    return invalid
end function

'-------------------------------------------------------------------------------
' withAction
'-------------------------------------------------------------------------------
function withAction(response as object, request as object) as object
    if response = invalid then return { ok: false, action: "search", query: Strings.Trim(request.query), errorMessage: "Search failed." }

    response.AddReplace("action", "search")
    response.AddReplace("query", Strings.Trim(request.query))
    return response
end function

'-------------------------------------------------------------------------------
' getPayloadItems
'-------------------------------------------------------------------------------
function getPayloadItems(payload as dynamic) as object
    if payload = invalid then return []
    if Type(payload) = "roArray" then return payload
    if Arrays.IsAssocArray(payload) = false then return []
    if payload.Items <> invalid then return payload.Items

    return []
end function
